{
  "framework": "vite",
  "buildCommand": "npm run build",
  "installCommand": "npm install --include=dev",
  "rewrites": [
    {
      "source": "/uploads/:path*",
      "destination": "https://daiva-cosmetics-ecommerce.onrender.com/uploads/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://daiva-cosmetics-ecommerce.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
