# =================================================================
# AURA LUXE / DAIVA TECH - Environment Configuration Template
# =================================================================
# Copy this file to .env or configure these variables in Render / Cloud hosting.
# NEVER commit your real secrets to Git.

# --- ZOHO INVENTORY & BOOKS API CONFIGURATION ---
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_INVENTORY_URL=https://www.zohoapis.in/inventory/v1
ZOHO_CLIENT_ID=your_zoho_client_id_here
ZOHO_CLIENT_SECRET=your_zoho_client_secret_here
ZOHO_REFRESH_TOKEN=your_zoho_refresh_token_here
ZOHO_ORGANIZATION_ID=your_zoho_org_id_here

# --- RAZORPAY PAYMENT GATEWAY ---
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# --- XPRESSBEES LOGISTICS ---
XPRESSBEES_BASE_URL=https://shipment.xpressbees.com
XPRESSBEES_EMAIL=your_xpressbees_email_here
XPRESSBEES_PASSWORD=your_xpressbees_password_here
XPRESSBEES_ORIGIN_PINCODE=560001
XPRESSBEES_WAREHOUSE_NAME=Aura Luxe Cosmetics Hub
XPRESSBEES_WAREHOUSE_LINE1=124, 4th Cross, Indiranagar
XPRESSBEES_WAREHOUSE_CITY=Bengaluru
XPRESSBEES_WAREHOUSE_STATE=Karnataka
XPRESSBEES_WAREHOUSE_PHONE=+919876543210

# --- GOOGLE OAUTH IDENTITY SERVICES ---
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# --- SMTP TRANSACTIONAL EMAIL SERVICE ---
# Set APP_MAIL_ENABLED=true and provide your credentials ONLY in a local gitignored .env file or hosting env vars.
# NEVER commit credentials to Git.
APP_MAIL_ENABLED=false
APP_MAIL_FROM=concierge@auraluxe.com
APP_MAIL_FROM_NAME=Aura Luxe Paris
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_16_char_google_app_password
